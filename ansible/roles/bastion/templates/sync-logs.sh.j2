#!/bin/bash
# Managed by Ansible — do not edit manually
# Sync SSH auth logs to S2-MT monitoring VM

DEST_HOST="bastion-logs@192.168.20.1"
DEST_PATH="/var/log/bastion/bastion-auth.log"
LOG_FILE="/var/log/auth.log"
SSH_KEY="/home/bastion/.ssh/id_ed25519"

rsync -az --append \
  -e "ssh -i ${SSH_KEY} -o StrictHostKeyChecking=no" \
  ${LOG_FILE} \
  ${DEST_HOST}:${DEST_PATH}