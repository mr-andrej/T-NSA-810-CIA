# Visual Studio 2015/2017 cache/options directory
.vs/

# macOS
.DS_Store

# Terraform variable files (may contain secrets)
*.tfvars
*.tfvars.json

# But keep the example/template file
!terraform.tfvars.example

# Terraform state files (contain sensitive data)
*.tfstate
*.tfstate.backup
*.tfstate.*.backup

# Terraform directories
.terraform/
.terraform.lock.hcl

# Crash logs
crash.log
crash.*.log

# Override files
override.tf
override.tf.json
*_override.tf
*_override.tf.json

#JetBrains
.idea

# HashiCorp Vault — anything matching the following must never reach the repo
*.vault-token
vault-init-keys.txt
**/vault-snapshots/*
**/vault-secret-id
**/vault-ca.crt
ansible/roles/vault/files/vault-ca.crt

# Local env files that may carry plaintext secrets while populating Vault
.env
.env.*
!.env.example
secrets.env
