# Visual Studio 2015/2017 cache/options directory
.vs/

# Terraform variable files (may contain secrets)
*.tfvars
*.tfvars.json

# But keep the example/template file
!terraform.tfvars.example

# Terraform state files (contain sensitive data)
*.tfstate
*.tfstate.backup
*.tfstate.*.backup

# Terraform directories
.terraform/
.terraform.lock.hcl

# Crash logs
crash.log
crash.*.log

# Override files
override.tf
override.tf.json
*_override.tf
*_override.tf.json

#JetBrains
.idea
